# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=mim_dashboard
DB_USER=mim
DB_PASSWORD=changeme
DB_PORT=5432

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── Bitcoin Core data directory (optional — for cookie authentication) ────────
# Mount your .bitcoin directory so the backend can read the .cookie file.
# Example: BTC_DATA_DIR=/home/user/.bitcoin
# The directory is mounted read-only at /bitcoin-data inside the container.
# After setting this, rebuild: docker compose build && docker compose up -d
# BTC_DATA_DIR=

# NOTE: Bitcoin Core RPC, ZMQ endpoints, and admin password are configured
# through the setup wizard on first launch and stored in the database.
