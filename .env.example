# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=mim_dashboard
DB_USER=mim
DB_PASSWORD=changeme
DB_PORT=5432

# ── Bitcoin Core RPC ─────────────────────────────────────────────────────────
# Use host.docker.internal to reach the host machine from inside Docker
BTC_RPC_HOST=host.docker.internal
BTC_RPC_PORT=38332
BTC_RPC_USER=your_rpc_user
BTC_RPC_PASS=your_rpc_password

# ── ZeroMQ endpoints ─────────────────────────────────────────────────────────
ZMQ_BLOCK_URL=tcp://host.docker.internal:28332
ZMQ_TX_URL=tcp://host.docker.internal:28333
ZMQ_RAW_TX_URL=tcp://host.docker.internal:28334

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_PASSWORD=changeme
JWT_SECRET=change_this_to_a_long_random_string

# ── Bitcoin config path (optional — used for auto-reading rpc credentials) ───
# BTC_CONF_PATH=/home/user/.bitcoin/bitcoin.conf

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000
