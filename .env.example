# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=mim_dashboard
DB_USER=mim
DB_PASSWORD=changeme
DB_PORT=5432

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# NOTE: Bitcoin Core RPC, ZMQ endpoints, and admin password are configured
# through the setup wizard on first launch and stored in the database.
# The backend mounts the host filesystem read-only at /host-fs for auto-detection.
