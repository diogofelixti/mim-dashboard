# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=mim_dashboard
DB_USER=mim
DB_PASSWORD=changeme
DB_PORT=5432

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── Bitcoin Core data directory ───────────────────────────────────────────────
# Path to your .bitcoin directory on the HOST machine.
# This is mounted read-only at /bitcoin-data inside the backend container
# so the setup wizard can auto-detect bitcoin.conf and the .cookie file.
#
# Linux default:  /home/<your_user>/.bitcoin
# macOS default:  /Users/<your_user>/Library/Application Support/Bitcoin
#
BTC_DATA_DIR=/home/bilbo/.bitcoin

# NOTE: Bitcoin Core RPC, ZMQ endpoints, and admin password are configured
# through the setup wizard on first launch and stored in the database.
